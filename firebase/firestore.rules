rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function eggOwner(eggId) {
      return get(/databases/$(database)/documents/eggs/$(eggId)).data.ownerId;
    }

    function isEggHeatBump() {
      return isVerified()
        && resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heat'])
        && request.resource.data.heat is int
        && request.resource.data.heat >= resource.data.get('heat', 0)
        && request.resource.data.heat <= resource.data.get('heat', 0) + 10;
    }

    function eggViewCount() {
      return resource.data.keys().hasAny(['viewCount'])
        && resource.data.viewCount is int
        ? resource.data.viewCount
        : 0;
    }

    function isViewCountBump() {
      return isVerified()
        && resource.data.published == true
        && resource.data.ownerId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == eggViewCount() + 1;
    }

    function isEggStatusOk() {
      let newStatus = request.resource.data.get('status', resource.data.get('status', 'greetsya'));
      let oldStatus = resource.data.get('status', 'greetsya');
      return newStatus != 'kuritsa'
        && (newStatus == oldStatus || (oldStatus == 'greetsya' && newStatus == 'tsyplenok'));
    }

    function isEggOwnerEdit() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return isVerified()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerUsername == resource.data.ownerUsername
        && request.resource.data.published == resource.data.published
        && request.resource.data.get('heat', 0) == resource.data.get('heat', 0)
        && request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0)
        && isEggStatusOk()
        && (
          diff.hasOnly(['title', 'description', 'link', 'demoUrl', 'tags', 'seeking', 'updatedAt'])
          || diff.hasOnly(['title', 'description', 'link', 'demoUrl', 'tags', 'seeking', 'updatedAt', 'imageUrl'])
          || diff.hasOnly(['title', 'description', 'link', 'demoUrl', 'tags', 'seeking', 'updatedAt', 'imageUrl', 'status', 'hatchedAt'])
          || diff.hasOnly(['status', 'hatchedAt', 'updatedAt'])
          || diff.hasOnly(['updatedAt'])
        );
    }

    function isValidEggCreate() {
      return isVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.get('heat', 0) == 0
        && request.resource.data.get('viewCount', 0) == 0
        && request.resource.data.get('status', 'greetsya') == 'greetsya'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 500
        && request.resource.data.ownerUsername is string;
    }

    function isUserProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['displayName', 'username', 'bio', 'avatarUrl', 'updatedAt']
      );
    }

    function isUserHeatBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heat'])
        && request.resource.data.heat is int
        && request.resource.data.heat >= resource.data.get('heat', 0)
        && request.resource.data.heat <= resource.data.get('heat', 0) + 10;
    }

    function isValidUserCreate(userId) {
      return isVerified()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'avatarUrl', 'createdAt', 'updatedAt'
        ]);
    }

    function isValidNotificationCreate() {
      return isVerified()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.uid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.type in [
          'new_question', 'question_answered', 'tester_signed_up', 'new_follower', 'invest_interest'
        ]
        && (
          (request.resource.data.type == 'new_follower'
            && request.resource.data.uid != request.auth.uid)
          || (request.resource.data.eggId is string
            && request.resource.data.eggId.size() > 0
            && (
              (request.resource.data.type in ['new_question', 'tester_signed_up', 'invest_interest']
                && eggOwner(request.resource.data.eggId) == request.resource.data.uid)
              || (request.resource.data.type == 'question_answered'
                && eggOwner(request.resource.data.eggId) == request.auth.uid
                && request.resource.data.uid != request.auth.uid)
            ))
        );
    }

    function isValidHeatEventCreate() {
      return isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 64;
    }

    function isAllowedBadgeId(badgeId) {
      return badgeId in ['first_comment', 'laid_egg', 'hatched'];
    }

    match /pending_profiles/{uid} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isValidUserCreate(uid);
      allow update: if isVerified()
        && request.auth.uid == uid
        && (isUserProfileUpdate() || isUserHeatBump());
      allow delete: if isVerified() && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isVerified() && resource.data.uid == request.auth.uid;
    }

    match /eggs/{eggId} {
      allow read: if resource.data.published == true
        || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidEggCreate();
      allow update: if isVerified() && (
        isEggOwnerEdit()
        || isEggHeatBump()
        || isViewCountBump()
      );
      allow delete: if isVerified() && resource.data.ownerId == request.auth.uid;
    }

    match /egg_views/{viewId} {
      allow read: if isVerified();
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && eggOwner(request.resource.data.eggId) != request.auth.uid
        && request.resource.data.eggId is string
        && viewId == request.resource.data.eggId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    match /egg_comments/{commentId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.eggId is string;
      allow delete: if isVerified() && resource.data.authorId == request.auth.uid;
      allow update: if false;
    }

    match /egg_comment_reactions/{reactionId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.eggId is string
        && request.resource.data.vote in ['like', 'dislike']
        && reactionId == request.resource.data.commentId + '_' + request.auth.uid;
      allow update: if isVerified()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.vote in ['like', 'dislike'];
      allow delete: if isVerified() && resource.data.uid == request.auth.uid;
    }

    match /egg_updates/{updateId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.eggId is string
        && eggOwner(request.resource.data.eggId) == request.auth.uid;
      allow update, delete: if false;
    }

    match /egg_milestones/{milestoneId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.eggId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200
        && eggOwner(request.resource.data.eggId) == request.auth.uid;
      allow update, delete: if false;
    }

    match /egg_questions/{questionId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.authorId == request.auth.uid
        && eggOwner(request.resource.data.eggId) != request.auth.uid
        && request.resource.data.eggId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if isVerified()
        && request.resource.data.eggId == resource.data.eggId
        && eggOwner(resource.data.eggId) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerText', 'answeredAt']);
      allow delete: if false;
    }

    match /egg_testers/{testerId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eggId is string
        && testerId == request.resource.data.eggId + '_' + request.auth.uid;
      allow update: if isVerified() && (
        resource.data.uid == request.auth.uid
        || eggOwner(resource.data.eggId) == request.auth.uid
      );
      allow delete: if false;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.followerUid == request.auth.uid
        && followId == request.resource.data.followerUid + '_' + request.resource.data.targetUid;
      allow delete: if isVerified() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{notifId} {
      allow read: if isVerified() && resource.data.uid == request.auth.uid;
      allow create: if isValidNotificationCreate();
      allow update: if isVerified()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isVerified() && resource.data.uid == request.auth.uid;
    }

    match /invest_interest/{interestId} {
      allow read: if isVerified() && (
        resource.data.investorUid == request.auth.uid
        || eggOwner(resource.data.eggId) == request.auth.uid
      );
      allow create: if isVerified()
        && request.resource.data.investorUid == request.auth.uid
        && interestId == request.resource.data.eggId + '_' + request.auth.uid;
      allow update: if isVerified()
        && eggOwner(resource.data.eggId) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /heat_events/{eventId} {
      allow read: if false;
      allow create: if isValidHeatEventCreate();
      allow update, delete: if false;
    }

    match /user_badges/{badgeId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && badgeId == request.resource.data.uid + '_' + request.resource.data.badgeId
        && isAllowedBadgeId(request.resource.data.badgeId);
      allow update: if false;
      allow delete: if isVerified() && resource.data.uid == request.auth.uid;
    }

  }

}
