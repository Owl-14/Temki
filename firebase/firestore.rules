rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function eggOwner(eggId) {
      return get(/databases/$(database)/documents/eggs/$(eggId)).data.ownerId;
    }

    function isEggHeatBump() {
      return isVerified()
        && resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heat'])
        && request.resource.data.heat >= resource.data.get('heat', 0)
        && request.resource.data.heat <= resource.data.get('heat', 0) + 20;
    }

    function eggViewCount() {
      return resource.data.keys().hasAny(['viewCount'])
        && resource.data.viewCount is int
        ? resource.data.viewCount
        : 0;
    }

    function isViewCountBump() {
      return isVerified()
        && resource.data.published == true
        && resource.data.ownerId != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == eggViewCount() + 1;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isVerified() && request.auth.uid == uid;
      allow update: if isVerified() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isVerified() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isVerified() && resource.data.uid == request.auth.uid;
    }

    match /eggs/{eggId} {
      allow read: if resource.data.published == true
        || (isVerified() && resource.data.ownerId == request.auth.uid);
      allow create: if isVerified()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.published == true;
      allow update: if isVerified() && (
        resource.data.ownerId == request.auth.uid
        || isEggHeatBump()
        || isViewCountBump()
      );
      allow delete: if isVerified() && resource.data.ownerId == request.auth.uid;
    }

    match /egg_views/{viewId} {
      allow read: if isVerified();
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && eggOwner(request.resource.data.eggId) != request.auth.uid
        && request.resource.data.eggId is string
        && viewId == request.resource.data.eggId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    match /egg_comments/{commentId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.eggId is string;
      allow delete: if isVerified() && resource.data.authorId == request.auth.uid;
      allow update: if false;
    }

    match /egg_comment_reactions/{reactionId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.commentId is string
        && request.resource.data.eggId is string
        && request.resource.data.vote in ['like', 'dislike']
        && reactionId == request.resource.data.commentId + '_' + request.auth.uid;
      allow update: if isVerified()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.vote in ['like', 'dislike'];
      allow delete: if isVerified() && resource.data.uid == request.auth.uid;
    }

    match /egg_updates/{updateId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.eggId is string
        && eggOwner(request.resource.data.eggId) == request.auth.uid;
      allow update, delete: if false;
    }

    match /egg_milestones/{milestoneId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.eggId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200
        && eggOwner(request.resource.data.eggId) == request.auth.uid;
      allow update, delete: if false;
    }

    match /egg_questions/{questionId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.authorId == request.auth.uid
        && eggOwner(request.resource.data.eggId) != request.auth.uid
        && request.resource.data.eggId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if isVerified()
        && request.resource.data.eggId == resource.data.eggId
        && eggOwner(resource.data.eggId) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerText', 'answeredAt']);
      allow delete: if false;
    }

    match /egg_testers/{testerId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eggId is string
        && testerId == request.resource.data.eggId + '_' + request.auth.uid;
      allow update: if isVerified() && (
        resource.data.uid == request.auth.uid
        || eggOwner(resource.data.eggId) == request.auth.uid
      );
      allow delete: if false;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.followerUid == request.auth.uid
        && followId == request.resource.data.followerUid + '_' + request.resource.data.targetUid;
      allow delete: if isVerified() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{notifId} {
      allow read: if isVerified() && resource.data.uid == request.auth.uid;
      allow create: if isVerified();
      allow update: if isVerified()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /invest_interest/{interestId} {
      allow read: if isVerified() && (
        resource.data.investorUid == request.auth.uid
        || eggOwner(resource.data.eggId) == request.auth.uid
      );
      allow create: if isVerified()
        && request.resource.data.investorUid == request.auth.uid
        && interestId == request.resource.data.eggId + '_' + request.auth.uid;
      allow update: if isVerified()
        && eggOwner(resource.data.eggId) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /heat_events/{eventId} {
      allow read: if false;
      allow create: if isVerified() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /user_badges/{badgeId} {
      allow read: if true;
      allow create: if isVerified()
        && request.resource.data.uid == request.auth.uid
        && badgeId == request.resource.data.uid + '_' + request.resource.data.badgeId;
      allow update, delete: if false;
    }

  }

}
